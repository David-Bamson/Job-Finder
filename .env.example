# Copy this file to .env and fill in real values. Never commit .env.

# --- Telegram ---
# Create a bot with @BotFather to get the token. Chat ID is where alerts get sent
# (your own user ID, or a group/channel ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notion ---
# Internal integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=
# Database that logs every job and its status
NOTION_JOBS_DATABASE_ID=
# Database holding the trusted company list
NOTION_TRUSTED_COMPANIES_DATABASE_ID=

# --- Web search, used by the grading layer to check company reviews / scam reports ---
# https://serpapi.com — swap for another search provider if you prefer
SERPAPI_API_KEY=

# --- Email, used to read LinkedIn job alert emails (LinkedIn itself is not scraped) ---
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_SERVER=imap.gmail.com

# --- Discovery source endpoints (defaults shown, override only if needed) ---
REMOTEOK_API_URL=https://remoteok.com/api
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
WEWORKREMOTELY_RSS_URL=https://weworkremotely.com/remote-jobs.rss

# --- Candidate profile, used to steer fit matching (see profile/README.md) ---
PROFILE_PATH=profile/candidate_profile.md

# --- Cost control: only run the SerpApi-heavy legitimacy check on jobs
# whose fit score already clears this bar (0-100) ---
FIT_SCORE_THRESHOLD_FOR_FULL_CHECK=65

# --- Scheduler / general ---
POLL_INTERVAL_HOURS=4
LOG_LEVEL=INFO